<?xml version="1.0" encoding="utf-8"?>
<!--
  One frame of the COMING UP ticker. Deliberately quieter than a list row - smaller poster, smaller
  type, muted colours - because it is peripheral information that happens to be moving, and moving
  things pull the eye hard enough already without also being the brightest thing on screen.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical">

    <ImageView
        android:id="@id/comingup_poster"
        android:layout_width="26dp"
        android:layout_height="36dp"
        android:scaleType="centerCrop"
        android:contentDescription="@null" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="9dp"
        android:orientation="vertical">

        <TextView
            android:id="@id/comingup_meta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:includeFontPadding="false"
            android:textColor="#8AD8B45F"
            android:textSize="11sp" />

        <TextView
            android:id="@id/comingup_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:ellipsize="end"
            android:fontFamily="serif"
            android:includeFontPadding="false"
            android:textColor="#B3F3EDE3"
            android:textSize="14sp" />
    </LinearLayout>
</LinearLayout>
