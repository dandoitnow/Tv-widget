<?xml version="1.0" encoding="utf-8"?>
<!--
  One list row's surface. Rows used to be separated by a 1dp hairline — a hard edge, and the single
  most "spreadsheet" thing in the old design. They're now soft-cornered surfaces separated by air
  instead, which is what actually makes a list read as designed rather than tabulated.

  The gradient runs a hair lighter at the top edge, which is all the "lift" RemoteViews can express:
  it has no elevation or shadow, so implied light direction has to do that job.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <gradient
        android:angle="270"
        android:startColor="#221D18"
        android:endColor="#191512"
        android:type="linear" />
    <corners android:radius="18dp" />
</shape>
