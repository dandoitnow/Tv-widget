<?xml version="1.0" encoding="utf-8"?>
<!--
  Shown only until real key art is cached. The old version was flat #262626 with the word "POSTER"
  stamped on it, which drew attention to the thing that was missing. This is a quiet diagonal
  gradient with no label at all — an empty poster should recede, not announce itself.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <gradient
        android:angle="315"
        android:startColor="#272220"
        android:endColor="#171412"
        android:type="linear" />
    <corners android:radius="8dp" />
</shape>
