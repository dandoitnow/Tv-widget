<?xml version="1.0" encoding="utf-8"?>
<!--
  The selected tab pill wrapped in a ripple.

  Nothing should be tappable and silent. RemoteViews will not let Glance attach a ripple to a
  generated bitmap background, but a drawable *resource* can be a <ripple> with the shape inside it,
  and the host honours it like any other background - so the pills answer a finger where they used
  to absorb it. The mask keeps the ripple inside the capsule instead of flooding the whole row.
-->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="#3DD8B45F">
    <item android:id="@android:id/mask" android:drawable="@drawable/shape_pill_selected" />
    <item android:drawable="@drawable/shape_pill_selected" />
</ripple>
